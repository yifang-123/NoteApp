name: Build APK from Zip

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:   # 允许手动触发

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extract zip file
        run: |
          ls -la
          if [ -f NoteApp.zip ]; then
            echo "Found NoteApp.zip, extracting..."
            unzip -o NoteApp.zip -d .
            rm NoteApp.zip
          elif [ -f *.zip ]; then
            echo "Found other zip, extracting first one..."
            ZIP_FILE=$(ls *.zip | head -n1)
            unzip -o "$ZIP_FILE" -d .
            rm "$ZIP_FILE"
          else
            echo "No zip file found, assuming code already extracted."
          fi
          ls -la

      - name: Set up JDK 17
        uses: actions/setup-java@v3
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew

      - name: Build debug APK
        run: ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NoteApp-Debug-APK
          path: app/build/outputs/apk/debug/

